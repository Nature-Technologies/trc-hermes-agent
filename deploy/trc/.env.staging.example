# TRC staging environment for hermes-agent.
#
# The deploy workflow (.github/workflows/trc-staging-deploy.yml) renders the
# real .env.staging from repository secrets and passes it to `docker compose`
# via --env-file. That file stays on the CI runner and is never copied to the
# server -- the local Compose CLI reads it and sends the values to the remote
# daemon (over the deploy's Docker context) as container environment. This
# file is documentation and is also parsed by deploy/trc/validate_compose.py,
# which fills each key with a placeholder to prove `docker compose config`
# renders. Every variable the compose file references must be listed here.

# Moving-tag image. Written by the deploy workflow as
# ${IMAGE_REPO}:${IMAGE_TAG} (see trc-staging-deploy.yml's `env:` block, which
# defaults IMAGE_TAG to `dev`) -- trc-publish.yml republishes that tag on every
# push to `dev`. There is no digest input any more: to roll back, point
# IMAGE_TAG at a `sha-<short-sha>` tag and re-run the deploy.
HERMES_IMAGE=ghcr.io/nature-technologies/trc-hermes-agent:dev

# Secret: OPENROUTER_API_KEY
OPENROUTER_API_KEY=

# Secret: HERMES_API_KEY. Guards :8642 -- an empty value leaves an open LLM
# gateway to anyone who can reach the port. MUST be >=16 characters; the
# gateway refuses to start the API server below that, and the failure looks
# like a connection error rather than an auth error.
#   openssl rand -hex 32
#
# SHARED VALUE: trc-open-webui sets the same value as its OPENAI_API_KEY, and
# Paperclip holds a third copy in its instance config.json. Nothing structural
# keeps the three in sync -- the open-webui deploy smoke test is what detects a
# mismatch.
HERMES_API_KEY=

# Secrets. HERMES_DASHBOARD_INSECURE no longer bypasses this gate (June 2026
# hardening) -- without these the dashboard is unreachable.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=

# Host bind address. 8642/9119 stay on loopback: only in-network services need
# them.
HERMES_BIND=127.0.0.1

# Absolute path on the staging host where the deploy places config.yaml.
# Must be absolute: the remote Docker daemon resolves bind-mount sources, so a
# relative path would refer to the CI runner's filesystem.
HERMES_CONFIG_PATH=/srv/trc/staging/hermes-agent/config.yaml
