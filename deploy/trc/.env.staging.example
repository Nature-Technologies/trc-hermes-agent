# TRC staging environment for hermes-agent.
#
# The deploy workflow (.github/workflows/trc-staging-deploy.yml) renders the
# real .env from repository secrets and copies it to
# /srv/trc/staging/hermes-agent/.env at mode 0600. This file is documentation
# and is also parsed by deploy/trc/validate_compose.py, which fills each key
# with a placeholder to prove `docker compose config` renders. Every variable
# the compose file references must be listed here.

# Digest-pinned image. Written by CI from the workflow's `image_digest` input;
# never a mutable tag, so a deploy is reproducible and rollback is a
# re-dispatch with the previous digest.
HERMES_IMAGE=ghcr.io/nature-technologies/trc-hermes-agent@sha256:REPLACE_ME

# Secret: OPENROUTER_API_KEY
OPENROUTER_API_KEY=

# Secret: HERMES_API_KEY. Guards :8642 -- an empty value leaves an open LLM
# gateway to anyone who can reach the port. MUST be >=16 characters; the
# gateway refuses to start the API server below that, and the failure looks
# like a connection error rather than an auth error.
#   openssl rand -hex 32
#
# SHARED VALUE: trc-open-webui sets the same value as its OPENAI_API_KEY, and
# Paperclip holds a third copy in its instance config.json. Nothing structural
# keeps the three in sync -- the open-webui deploy smoke test is what detects a
# mismatch.
HERMES_API_KEY=

# Secrets. HERMES_DASHBOARD_INSECURE no longer bypasses this gate (June 2026
# hardening) -- without these the dashboard is unreachable.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=

# Host bind address. 8642/9119 stay on loopback: only in-network services need
# them.
HERMES_BIND=127.0.0.1
