# TRC staging environment for hermes-agent.
#
# The deploy workflow (.github/workflows/trc-staging-deploy.yml) renders the
# real .env.staging from repository secrets, ON THE SELF-HOSTED RUNNER, in its
# "Render the environment file" step, and passes it to the LOCAL `docker
# compose` via --env-file. It is consumed locally and never copied to the
# staging host: compose reads it on the runner and sends the values to the
# host's daemon over the SSH-tunnelled Docker API as container environment, so
# no plaintext secret is ever written to the host's filesystem. The rendered
# file is deleted by the workflow's `if: always()` cleanup step, because the
# runner is persistent.
#
# This example file is documentation AND is parsed by
# deploy/trc/validate_compose.py, which fills each key with a placeholder to
# prove `docker compose config` renders. Only the KEYS are read; the values
# below are illustrative. Every variable the compose file references must be
# listed here.

# Image to deploy. The workflow builds and pushes two tags on every dispatch:
# the moving `:staging` pointer and the IMMUTABLE `:git-<7-char-sha>` naming
# the exact commit built. `HERMES_IMAGE` is rendered as the `:git-<7>` one --
# never `:staging` -- so "what is running" is unambiguous and cannot be changed
# under the deploy by a later, unrelated run. There is no separate publish
# workflow: build, push and deploy are one dispatch, so the tag always exists
# by the time compose pulls it. To roll back, follow the procedure in
# docs/deploy/trc-staging.md, which dispatches from a throwaway branch with the
# `DEPLOY_IMAGE` env line of the "Render the environment file" step hardcoded
# to an older `:git-<7>` tag.
HERMES_IMAGE=ghcr.io/nature-technologies/trc-hermes-agent:git-a96e335

# Secret: OPENROUTER_API_KEY
OPENROUTER_API_KEY=

# Secret: HERMES_API_KEY. Guards :8642 -- an empty value leaves an open LLM
# gateway to anyone who can reach the port. MUST be >=16 characters; the
# gateway refuses to start the API server below that, and the failure looks
# like a connection error rather than an auth error.
#   openssl rand -hex 32
#
# SHARED VALUE: trc-open-webui sets the same value as its OPENAI_API_KEY, and
# Paperclip holds a third copy in its instance config.json. Nothing structural
# keeps the three in sync -- the open-webui deploy smoke test is what detects a
# mismatch.
HERMES_API_KEY=

# Secrets. HERMES_DASHBOARD_INSECURE no longer bypasses this gate (June 2026
# hardening) -- without these the dashboard is unreachable.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=

# Host bind addresses, one per published port -- see the note in the compose
# file for why this is not a single variable. 8642 (gateway) stays on loopback:
# open-webui reaches it over poc-net by container name, never through a
# published port. 9119 (dashboard) is basic-auth gated and is published wider so
# operators reach it without an SSH tunnel; the host firewall decides who can.
HERMES_API_BIND=127.0.0.1
HERMES_DASHBOARD_BIND=0.0.0.0

# Absolute path on the staging host where the deploy places config.yaml.
# Must be absolute: the remote Docker daemon resolves bind-mount sources, so a
# relative path would refer to the CI runner's filesystem.
HERMES_CONFIG_PATH=/srv/trc/staging/hermes-agent/config.yaml
